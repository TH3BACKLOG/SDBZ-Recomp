# ---------------------------------------------------------------------------
# RECOMPILED GAME CODE — must never be committed.
#
# Everything under ps2xRuntime/src/runner/ is machine output derived from the
# retail SLUS-214.42 disc image: ~36,000 generated fn_*.cpp bodies plus the
# register_functions.cpp dispatch table (31 MB). It is the game's own code,
# just transliterated to C++, so it carries the game's copyright.
#
# `src/runner/*` (not `src/runner/`) per the note above: git will not descend
# into an excluded DIRECTORY, which would break any future `!` negation here.
# ps2xRecomp/src/runner/main.cpp is a DIFFERENT tree (the recompiler tool's own
# entrypoint, upstream-authored) and is deliberately still tracked.
ps2xRuntime/src/runner/*

# Same for the VU1 micro programs: build_scripts/vu1_recomp.py translates the
# game's VU1 microcode (dumped from its micro memory) into C++ and embeds the
# code bytes in the lookup table. Game code; regenerate locally.
ps2xRuntime/src/lib/Kernel/Vu1Recomp/generated/*

# Auto-generated from a regex scan of game_overrides.cpp on every build; 4.2 MB
# of declarations naming every guest function. Regenerated, never hand-edited.
ps2xRuntime/include/fn_forward_decls.h

# Guest symbol table extracted from the retail ELF (generate_symbols_map.ps1).
ps2xRuntime/symbols.map

# Per-run diagnostic sink (PS2X_PROBE_FILE) — truncated every run.
run_probe.jsonl

# Recompiler config: machine-specific absolute paths to the local ELF/ISO dump.
config.toml
